# SUPABASE CONFIG
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# GEMINI API
GEMINI_API_KEY="your-gemini-api-key"

# AVISA API CONFIG
AVISA_BASE_URL="sua-url-avisa"
AVISA_TOKEN="seu-token-avisa"

# UPSTASH REDIS (Fase 2 — Deduplicação + Cache de Histórico)
# Obtenha em: https://console.upstash.com → seu database → REST API
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# CONFIGURAÇÕES DA LOJA
NEXT_PUBLIC_ZAPI_PHONE="5541999999999"  # Telefone do Gerente para Alertas

# INSTRUÇÕES DE DEPLOY (VERCEL)
# 1. Copie essas variáveis para a Vercel em Settings > Environment Variables.
# 2. No AVISA API, atualize a URL de Webhook para: https://seu-app.vercel.app/api/webhook/avisa
# 3. Upstash: crie um database em upstash.com (plano gratuito: 10k req/dia).

# ── PagBank (recebimento das assinaturas — substitui o Pagar.me) ──
# Token da conta: iBanking PagBank > Vendas > Integrações > Gerar token.
PAGBANK_TOKEN=
# sandbox | production
PAGBANK_ENV=sandbox
# Liga o /assinar no PagBank (sem isso continua no Pagar.me legado)
NEXT_PUBLIC_GATEWAY=pagbank
# Webhook a cadastrar no PagBank: https://www.autozap.digital/api/pagbank/webhook
